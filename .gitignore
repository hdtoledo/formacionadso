# ==============================================================================
# .gitignore - Plataforma de Lecciones Técnicas ADSO (SENA Garzón)
# ==============================================================================

# 1. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 2. Archivos y Configuraciones de IDEs / Editores
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# 3. Variables de Entorno y Credenciales Sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# 4. Dependencias y Caches
node_modules/
jspm_packages/
.pnp/
.pnp.js
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 5. Logs y Depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Salidas de Compilación y Distribución
dist/
build/
out/
.next/
.cache/

# 7. Prevención de Scripts Temporales, Pruebas y Dumps de BD
# (Evita subir scripts no oficiales o basura generada durante las clases)
tmp/
temp/
scratch/
*.tmp
*.temp
*.bak

# Scripts sueltos de prueba o volcados locales
test*.sql
test_*.sql
temp*.sql
prueba*.sql
pruebas*.sql
dump*.sql
backup*.sql
export*.sql
*.dump
*.sqlite
*.sqlite3
*.db

# Scripts de prueba sueltos en JS/Python/Bash
test_*.js
temp_*.js
prueba_*.js
*.scratch.*

# Archivos comprimidos de backups
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ==============================================================================
# PLANIFICACIÓN Y NOTAS INTERNAS DEL INSTRUCTOR (Uso local)
# ==============================================================================
[Pp]lan[Ss]esiones.md
plansesiones.md
planSesiones.md

# ==============================================================================
# EXCEPCIONES PERMITIDAS: Recursos y Scripts Oficiales del Plan Curricular
# ==============================================================================
!semana-*/dia-*/recursos/*.sql
!semana-*/dia-*/recursos/*
