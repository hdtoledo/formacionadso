# =============================================================================
# SENA CADPH Garzón · Regional Huila - ADSO Desarrollo Web Full Stack MERN
# Plantilla de Variables de Entorno (NO incluir credenciales reales aquí)
# Copie este archivo como server/.env y complete sus valores.
# server/.env NUNCA se sube a GitHub (está en .gitignore).
# =============================================================================

# Servidor Express
PORT=3000
NODE_ENV=development

# Origen autorizado por CORS (frontend Vite + React de la Semana 4)
CLIENT_URL=http://localhost:5173

# Base de Datos Relacional (PostgreSQL - Sesión 06: creada como adso_auth_db)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=adso_auth_db
PG_USER=postgres
PG_PASSWORD=<tu_contraseña_local>
PG_MAX_POOL=10
PG_IDLE_TIMEOUT=30000

# Base de Datos Documental NoSQL (MongoDB Atlas - Sesión 07)
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/adso_polyglot_db?retryWrites=true&w=majority
