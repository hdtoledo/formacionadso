# Servidor Express
PORT=3000
NODE_ENV=development

# Base de Datos Relacional (PostgreSQL - Sesión 06)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=adso_polyglot_db
PG_USER=postgres
PG_PASSWORD=tu_contraseña_local_aqui
PG_MAX_POOL=10
PG_IDLE_TIMEOUT=30000

# Base de Datos Documental NoSQL (MongoDB Atlas - Sesión 07)
MONGO_URI=mongodb+srv://usuario_atlas:password_atlas@cluster0.abcde.mongodb.net/adso_polyglot_db?retryWrites=true&w=majority
