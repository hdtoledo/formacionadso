meta {
  name: 11 - Re-verificar Cuenta (409 Conflict)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/dev/users/b0000000-0000-0000-0000-000000000002/verify
  body: none
  auth: none
