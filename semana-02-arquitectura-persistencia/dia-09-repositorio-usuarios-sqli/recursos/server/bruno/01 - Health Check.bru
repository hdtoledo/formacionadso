meta {
  name: 01 - Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

tests {
  test("Health Check", function () {
    expect(res.status).to.equal(200);
    expect(res.body.services.postgres.status).to.equal("healthy");
  });
}

docs {
  Envía: GET sin body.
  Debe responder: 200 con services.postgres.status = "healthy".
  Si falla, revise server/.env antes de seguir: sin PostgreSQL ninguna prueba funcionará.
}
