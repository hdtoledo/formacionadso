meta {
  name: 03 - Crear Duplicado en Mayúsculas (409 Conflict)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "NUEVO.APRENDIZ@misena.edu.co"
  }
}

tests {
  test("Crear Duplicado en Mayúsculas (409 Conflict)", function () {
    expect(res.status).to.equal(409);
    expect(res.body.success).to.equal(false);
    expect(res.body.code).to.equal("EMAIL_ALREADY_EXISTS");
  });
}

docs {
  Envía: el mismo correo de la 02 con otras mayúsculas. Requiere haber ejecutado la 02.
  Debe responder: 409 con code "EMAIL_ALREADY_EXISTS" en el formato estándar de error.
  Demuestra: PostgreSQL lanza 23505 (uq_users_email) y el repositorio lo traduce a AppError 409.
}
