meta {
  name: 08 - Buscar por ID Inválido (400 Bad Request)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/dev/users/123
  body: none
  auth: none
}

tests {
  test("Buscar por ID Inválido (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_ID");
  });
}

docs {
  Un id que no es UUID se rechaza con 400 (sin validación, PostgreSQL lanzaría 22P02 y sería un 500).
}
