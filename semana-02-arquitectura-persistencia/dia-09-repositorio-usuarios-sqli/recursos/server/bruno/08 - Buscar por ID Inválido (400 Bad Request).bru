meta {
  name: 08 - Buscar por ID Inválido (400 Bad Request)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/dev/users/123
  body: none
  auth: none
}

tests {
  test("Buscar por ID Inválido (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_ID");
  });
}

docs {
  Envía: GET con un id que no es UUID (123).
  Debe responder: 400 con code "INVALID_ID".
  Demuestra: sin isUuid, PostgreSQL lanzaría 22P02 (invalid_text_representation) y la API respondería 500.
}
