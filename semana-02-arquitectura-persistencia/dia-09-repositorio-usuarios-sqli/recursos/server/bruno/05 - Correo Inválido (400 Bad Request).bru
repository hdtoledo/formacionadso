meta {
  name: 05 - Correo Inválido (400 Bad Request)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": 12345
  }
}

tests {
  test("Correo Inválido (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.fieldErrors).to.have.property("email");
  });
}

docs {
  Envía: { "email": 12345 } (un número, no un texto).
  Debe responder: 400 con code "VALIDATION_ERROR" y fieldErrors.email.
  Demuestra: isValidEmail rechaza la entrada antes de tocar la base de datos.
}
