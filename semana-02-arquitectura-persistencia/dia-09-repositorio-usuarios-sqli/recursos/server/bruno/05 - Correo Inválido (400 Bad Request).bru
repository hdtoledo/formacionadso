meta {
  name: 05 - Correo Inválido (400 Bad Request)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": 12345
  }
}

tests {
  test("Correo Inválido (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.fieldErrors).to.have.property("email");
  });
}

docs {
  Un número no es un correo: se rechaza antes de llegar a la base de datos.
}
