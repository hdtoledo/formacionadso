meta {
  name: 10 - Cambiar Tipo (422 Unprocessable Entity)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/dev/content/{{contentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "banner"
  }
}

tests {
  test("Cambiar Tipo (422 Unprocessable Entity)", function () {
    expect(res.status).to.equal(422);
    expect(res.body.code).to.equal("CONTENT_TYPE_IMMUTABLE");
  });
}

docs {
  Envía: PATCH con { "type": "banner" } a un servicio.
  Debe responder: 422 CONTENT_TYPE_IMMUTABLE.
  Demuestra: la petición es válida, pero la regla de negocio impide cambiar el discriminator.
}
