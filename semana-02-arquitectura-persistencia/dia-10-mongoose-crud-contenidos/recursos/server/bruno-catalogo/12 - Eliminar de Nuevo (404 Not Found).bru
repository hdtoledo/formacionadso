meta {
  name: 12 - Eliminar de Nuevo (404 Not Found)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/dev/content/{{contentId}}
  body: none
  auth: none
}

tests {
  test("Eliminar de Nuevo (404 Not Found)", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("CONTENT_NOT_FOUND");
  });
}

docs {
  Envía: el mismo DELETE de la 11.
  Debe responder: 404 CONTENT_NOT_FOUND.
  Demuestra: el controlador distingue "id mal formado" (400) de "no existe" (404).
}
