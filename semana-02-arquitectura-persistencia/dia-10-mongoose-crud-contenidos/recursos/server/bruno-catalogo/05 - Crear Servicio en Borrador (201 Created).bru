meta {
  name: 05 - Crear Servicio en Borrador (201 Created)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/dev/content
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "service",
    "name": "Analítica de Datos para el Agro",
    "category": "agroindustria",
    "description": "Tableros de producción agrícola con datos abiertos del Huila.",
    "icon": "bar-chart",
    "code": "SRV-DATA-05",
    "hours": 40,
    "views": 999999
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("contentId", res.body.data._id);
}

tests {
  test("Crear Servicio en Borrador (201 Created)", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.type).to.equal("service");
    expect(res.body.data.code).to.equal("SRV-DATA-05");
    expect(res.body.data.active).to.equal(false);
    expect(res.body.data.views).to.equal(0);
  });
}

docs {
  Envía: un servicio completo con "views": 999999 (intento de inflar métricas).
  Debe responder: 201 con _id, type "service", active false (borrador) y views 0: views es un campo protegido.
  El script post-response guarda data._id en la variable {{contentId}}, que usan la petición 08 (en Tests) y las peticiones 09 a 12 (en la URL).
}
