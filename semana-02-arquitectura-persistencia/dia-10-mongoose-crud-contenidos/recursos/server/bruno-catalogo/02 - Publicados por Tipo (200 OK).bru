meta {
  name: 02 - Publicados por Tipo (200 OK)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/content/published?type=service
  body: none
  auth: none
}

tests {
  test("Publicados por Tipo (200 OK)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.be.greaterThan(0);
    expect(res.body.data.every((c) => c.active === true)).to.equal(true);
    expect(res.body.data.every((c) => c.type === "service")).to.equal(true);
  });
}

docs {
  Envía: GET con ?type=service.
  Debe responder: 200 solo con servicios publicados (4 con la semilla de la Sesión 07).
  Demuestra: filtro por discriminator validado contra la lista blanca CONTENT_TYPES.
}
