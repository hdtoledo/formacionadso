meta {
  name: 09 - Publicar Contenido (200 OK)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/dev/content/{{contentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "active": true
  }
}

tests {
  test("Publicar Contenido (200 OK)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data._id).to.equal(bru.getVar("contentId"));
    expect(res.body.data.active).to.equal(true);
  });
}

docs {
  Envía: PATCH con { "active": true } al contenido de la 05.
  Debe responder: 200 con active true. Si vuelve a ejecutar la 01, ahora aparece en la Landing.
  Demuestra: doc.set + doc.save ejecuta todas las validaciones del discriminator.
}
