meta {
  name: 01 - Contenidos Publicados (200 OK)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/content/published
  body: none
  auth: none
}

tests {
  test("Contenidos Publicados (200 OK)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.length).to.be.greaterThan(0);
    expect(res.body.data.every((c) => c.active === true)).to.equal(true);
    expect(res.body.meta.limit).to.equal(20);
  });
}

docs {
  Envía: GET sin parámetros (ruta pública de la Landing Page).
  Debe responder: 200 con data[] (solo active: true) y meta { count, limit: 20 }. Con la semilla de la Sesión 07: count 10.
  Demuestra: el filtro { active: true } y el límite por defecto de parseLimit.
}
