meta {
  name: 06 - Banner con Enlace JavaScript Malicioso (400 Bad Request)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/dev/content
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "banner",
    "title": "Banner malicioso",
    "ctaUrl": "javascript:alert(document.cookie)"
  }
}

tests {
  test("Banner con Enlace JavaScript Malicioso (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.fieldErrors).to.have.property("ctaUrl");
  });
}

docs {
  El esquema solo acepta enlaces https:// o rutas internas: bloquea un XSS futuro en el <a href> de React.
}
