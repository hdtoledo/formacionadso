meta {
  name: 04 - Límite Fuera de Rango (400 Bad Request)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/content/published?limit=500
  body: none
  auth: none
}

tests {
  test("Límite Fuera de Rango (400 Bad Request)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("VALIDATION_ERROR");
    expect(res.body.fieldErrors).to.have.property("limit");
  });
}

docs {
  Envía: ?limit=500.
  Debe responder: 400 con fieldErrors.limit = "Debe ser un número entero entre 1 y 50.".
  Demuestra: parseLimit pone un tope; nadie puede pedir la colección completa.
}
